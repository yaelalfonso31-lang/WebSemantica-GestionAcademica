PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX acad: <http://academico.edu.mx/ontologia#>

SELECT ?claveMateria ?nombreMateria ?claveRequisito ?nombreRequisito
WHERE {
    ?materia a acad:Materia ;
             acad:id ?claveMateria ;
             acad:nombre ?nombreMateria ;
             acad:tienePrerrequisito ?requisito .
             
    ?requisito acad:id ?claveRequisito ;
               acad:nombre ?nombreRequisito .
}
ORDER BY ASC(?nombreMateria)