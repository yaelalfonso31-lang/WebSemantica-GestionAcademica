PREFIX acad: <http://academico.edu.mx/ontologia#>

# Profesores agrupados por la carrera de las materias que imparten.
SELECT DISTINCT ?carrera ?nombre ?departamento
WHERE {
    ?profesor a acad:Profesor ;
              acad:nombre ?nombre ;
              acad:departamento ?departamento ;
              acad:imparte ?materia .
    ?materia acad:perteneceACarrera ?uriCarrera .
    BIND(STRAFTER(STR(?uriCarrera), "recurso/carrera/") AS ?carrera)
}
ORDER BY ?carrera ?nombre
