PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX acad: <http://academico.edu.mx/ontologia#>

SELECT ?clave ?nombre ?creditos
WHERE {
    ?materia a acad:Materia ;
             acad:id ?clave ;
             acad:nombre ?nombre ;
             acad:creditos ?creditos .
}
ORDER BY ASC(?nombre)