<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- Hora en formato 24 h: 07:00, 15:30 ... -->
    <xs:simpleType name="Hora">
        <xs:restriction base="xs:string">
            <xs:pattern value="([01][0-9]|2[0-3]):[0-5][0-9]"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="TextoNoVacio">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:element name="grupos">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="grupo" minOccurs="0" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <!-- Debe existir en materias.xml (se comprueba en el servicio de asignaciones) -->
                            <xs:element name="materia_id">
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:pattern value="(CCOS|ICCS)[0-9]{3}"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="profesor_id">
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:pattern value="P[0-9]{3,4}"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>
                            <xs:element name="periodo" type="TextoNoVacio"/>
                            <xs:element name="dia" type="TextoNoVacio"/>
                            <xs:element name="hora_inicio" type="Hora"/>
                            <xs:element name="hora_fin" type="Hora"/>
                            <xs:element name="aula" type="TextoNoVacio"/>
                        </xs:sequence>
                        <xs:attribute name="id" use="required">
                            <xs:simpleType>
                                <xs:restriction base="xs:ID">
                                    <xs:pattern value="G-(CCOS|ICCS)[0-9]{3}-[0-9]{2}"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>
